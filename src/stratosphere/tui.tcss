Screen {
    background: #000000;
    color: #cccccc;
}

#brand, Footer {
    background: #1a1a1a;
    color: #aaaaaa;
}

#brand {
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: #ffffff;
}

.compact-workspace #brand, FooterKey.-disabled {
    display: none;
}

Footer .footer-key--key {
    color: #ffffff;
    padding: 0 1;
}

Footer .footer-key--description {
    color: #aaaaaa;
    padding: 0 1 0 0;
}

#navigation {
    height: 1;
    background: #0a0a0a;
}

#navigation Underline {
    display: none;
}

#navigation Tab {
    height: 1;
    padding: 0 1;
    min-width: 0;
    margin-right: 1;
    color: #999999;
    background: #0a0a0a;
}

#navigation Tab.-active {
    text-style: bold;
    color: #ffffff;
    background: #333333;
}

#status {
    height: 1;
    padding: 0 1;
    background: #000000;
    color: #8a8a8a;
}

#status.busy-status {
    color: #ffffff;
}

#status.error-status {
    color: #ff6666;
}

#panes {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 0;
    height: 1fr;
}

.pane {
    height: 100%;
    border: solid #333333;
    background: #0a0a0a;
}

.pane:focus-within, .pane:focus {
    border: solid #ffffff;
}

.pane-title {
    height: 1;
    padding: 0 1;
    background: #1a1a1a;
    color: #aaaaaa;
    text-style: bold;
}

.pane:focus-within > .pane-title, .pane:focus > .pane-title {
    background: #333333;
    color: #ffffff;
}

.eyebrow {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #8a8a8a;
}

.empty-heading {
    height: auto;
    margin: 1 0;
    padding: 0 1;
    color: #cccccc;
    text-style: bold;
}

.muted {
    height: auto;
    padding: 0 1;
    color: #8a8a8a;
}

.pane-body {
    height: 1fr;
}

#reports-pane.short-report .eyebrow {
    display: none;
}

#portfolio-pane.short-portfolio #positions,
#portfolio-pane.short-portfolio #portfolio-status {
    display: none;
}

DataTable {
    height: 1;
    margin-top: 1;
    background: #0a0a0a;
}

DataTable > .datatable--header {
    background: #1a1a1a;
    color: #cccccc;
    text-style: none;
}

#conversation {
    height: 1fr;
}

.message {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 1;
    border-left: solid #333333;
}

.welcome {
    padding: 1;
    color: #cccccc;
    border-left: none;
}

.welcome-brand {
    height: auto;
    margin: 1 2 0 2;
    color: #ffffff;
    text-style: bold;
}

.user-message {
    border-left: solid #cccccc;
    background: #1a1a1a;
}

.assistant-message {
    border-left: solid #333333;
}

.system-message {
    color: #8a8a8a;
}

.interrupted-message {
    border-left: solid #ddaa00;
}

#composer {
    height: 3;
    margin: 1 1 0 1;
    padding: 0 1;
    background: #0a0a0a;
    border: solid #555555;
    border-subtitle-color: #8a8a8a;
}

#composer:focus-within {
    border: solid #cccccc;
}

#prompt-marker {
    width: 2;
    height: 1;
    color: #ffffff;
}

#prompt, #prompt:focus {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: #0a0a0a;
    color: #ffffff;
}

#session-details {
    height: auto;
    margin: 1 1 0 1;
}

.session-note {
    margin-top: 1;
}

#panes.dense .eyebrow, #panes.dense DataTable {
    margin-top: 0;
}

#panes.dense .empty-heading {
    margin: 0 0 1 0;
}

#panes.dense .welcome {
    margin-top: 0;
    padding: 0 1;
}

#panes.dense .welcome-brand {
    display: none;
}

#panes.compact #composer {
    margin-top: 0;
}

#setup {
    height: auto;
    width: 1fr;
    margin: 1;
    padding: 1;
    border-left: solid #cccccc;
    background: #0a0a0a;
}

.setup-keys {
    height: auto;
    color: #8a8a8a;
}

.setup-heading {
    height: auto;
    color: #ffffff;
    text-style: bold;
}

.field-label {
    height: auto;
    color: #aaaaaa;
}

#setup Input, #setup Select, #setup SelectCurrent {
    background: #111111;
    color: #cccccc;
}

#setup Input {
    height: 1;
    border: none;
    padding: 0 1;
}

#setup SelectCurrent {
    border: solid #333333;
}

#setup Select:focus SelectCurrent {
    border: solid #ffffff;
}

#setup Input:focus {
    background: #333333;
    color: #ffffff;
}

#setup-actions {
    height: 3;
    margin: 1 0 0 0;
}

#setup-actions Button {
    margin-right: 1;
    min-width: 10;
    border: solid #333333;
    background: #1a1a1a;
    color: #cccccc;
}

#setup-actions #use-model {
    color: #000000;
    background: #ffffff;
    border: solid #ffffff;
}

#setup-actions Button:focus {
    text-style: bold reverse;
}

#privacy-notice {
    height: auto;
    margin-top: 1;
    color: #8a8a8a;
}

#setup-error {
    height: auto;
    color: #ff6666;
}

#research-form, #study-form, #yahoo-form {
    height: auto;
    margin: 1;
    padding: 1;
    border-left: solid #cccccc;
}

#research-source, #study-hypothesis {
    height: 8;
    min-height: 3;
    border: solid #555555;
    background: #111111;
}

#research-form Input, #study-form Input, #yahoo-form Input {
    height: 1;
    padding: 0 1;
    border: none;
    background: #111111;
}

#research-form Input:focus, #study-form Input:focus, #yahoo-form Input:focus {
    background: #333333;
}

.research-help {
    height: auto;
    color: #8a8a8a;
}

#research-error {
    height: auto;
    color: #ff6666;
}

.research-actions, .research-review {
    height: 3;
    margin-top: 1;
}

.research-review {
    margin: 1;
}

.research-actions Button, .research-review Button {
    min-width: 10;
    width: auto;
    margin-right: 1;
    background: #1a1a1a;
    border: solid #555555;
    color: #cccccc;
}
